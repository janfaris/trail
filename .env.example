# Trail web env
# Copy to .env.local and fill in real values.

# Neon (or any Postgres) connection string
DATABASE_URL=

# GitHub OAuth app (https://github.com/settings/developers)
# Authorization callback URL must be: http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Random 32+ byte secret for better-auth (openssl rand -base64 32)
BETTER_AUTH_SECRET=

# Base URL of the web app (used by better-auth)
BETTER_AUTH_URL=http://localhost:3000
