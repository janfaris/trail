{
  "name": "@gettrail/cli",
  "version": "0.1.0",
  "description": "Local-capture CLI for cost-per-PR tracking on Claude Code, Codex, and other AI coding agents. No admin keys required.",
  "keywords": [
    "ai",
    "cost-tracking",
    "claude-code",
    "codex",
    "openai",
    "anthropic",
    "llm",
    "cli",
    "pull-request",
    "developer-tools"
  ],
  "homepage": "https://gettrail.vercel.app",
  "bugs": {
    "url": "https://github.com/janfaris/trail/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/janfaris/trail.git",
    "directory": "apps/cli"
  },
  "license": "MIT",
  "author": "Jan Karlo Faris García",
  "type": "module",
  "bin": {
    "trail": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@hono/node-server": "1.13.7",
    "better-sqlite3": "11.5.0",
    "chalk": "5.3.0",
    "chokidar": "4.0.1",
    "commander": "12.1.0",
    "hono": "4.6.12",
    "open": "10.1.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@trail/anonymize": "workspace:*",
    "@trail/client": "workspace:*",
    "@trail/parsers": "workspace:*",
    "@trail/schema": "workspace:*",
    "@types/better-sqlite3": "^7.6.12",
    "tsup": "^8.3.5",
    "vitest": "^2.1.8"
  }
}
